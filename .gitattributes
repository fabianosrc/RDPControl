# Normalize line endings
* text=auto eol=lf

# PowerShell files must use CRLF
*.ps1    text eol=crlf
*.psm1   text eol=crlf
*.psd1   text eol=crlf
*.ps1xml text eol=crlf

# Text files must use CRLF
*.txt text eol=crlf

# Web / Template files
*.html text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.xml  text eol=lf

# Binary files
*.dll binary
*.png binary
*.jpg binary