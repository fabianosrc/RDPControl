# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Global defaults
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# PowerShell files
[*.{ps1,psm1,psd1}]
charset = utf-8-bom
end_of_line = crlf
indent_size = 4

# Markdown
[*.md]
indent_size = 2
trim_trailing_whitespace = false

# YAML
[*.{yml,yaml}]
indent_size = 2

# XML
[*.xml]
indent_size = 2

# JSON
[*.json]
charset = utf-8
end_of_line = lf
indent_size = 4

# Text files
[*.txt]
end_of_line = crlf
