<?xml version="1.0" encoding="utf-8"?>
<Configuration>
    <ViewDefinitions>
        <!-- ============================================================ -->
        <!-- RDPControl.DryRunResult                                      -->
        <!-- ============================================================ -->
        <View>
            <Name>RDPControl.DryRunResult</Name>
            <ViewSelectedBy>
                <TypeName>RDPControl.DryRunResult</TypeName>
            </ViewSelectedBy>
            <ListControl>
                <ListEntries>
                    <ListEntry>
                        <ListItems>
                            <ListItem>
                                <Label>DryRun</Label>
                                <ScriptBlock>'True (no changes applied)'</ScriptBlock>
                            </ListItem>
                            <ListItem>
                                <Label>Binary Path</Label>
                                <PropertyName>BinaryPath</PropertyName>
                            </ListItem>
                            <ListItem>
                                <Label>Binary Version</Label>
                                <PropertyName>BinaryVersion</PropertyName>
                            </ListItem>
                            <ListItem>
                                <Label>Hash (SHA-256)</Label>
                                <PropertyName>Hash</PropertyName>
                            </ListItem>
                            <ListItem>
                                <Label>Current State</Label>
                                <PropertyName>CurrentState</PropertyName>
                            </ListItem>
                            <ListItem>
                                <Label>Target State</Label>
                                <PropertyName>TargetState</PropertyName>
                            </ListItem>
                            <ListItem>
                                <Label>Signature Found</Label>
                                <PropertyName>SignatureFound</PropertyName>
                            </ListItem>
                            <ListItem>
                                <Label>Policy Applicable</Label>
                                <PropertyName>PolicyApplicable</PropertyName>
                            </ListItem>
                            <ListItem>
                                <Label>Strategy</Label>
                                <PropertyName>Strategy</PropertyName>
                            </ListItem>
                            <ListItem>
                                <Label>Detection Mode</Label>
                                <PropertyName>DetectionMode</PropertyName>
                            </ListItem>
                            <ListItem>
                                <Label>Confidence</Label>
                                <PropertyName>Confidence</PropertyName>
                            </ListItem>
                            <ListItem>
                                <Label>Signature Offset</Label>
                                <PropertyName>SignatureOffset</PropertyName>
                            </ListItem>
                            <ListItem>
                                <Label>Write Offset</Label>
                                <PropertyName>WriteOffset</PropertyName>
                            </ListItem>
                            <ListItem>
                                <Label>Branch Type</Label>
                                <PropertyName>BranchType</PropertyName>
                            </ListItem>
                            <ListItem>
                                <Label>Current Bytes</Label>
                                <PropertyName>CurrentBytes</PropertyName>
                            </ListItem>
                            <ListItem>
                                <Label>Enforcement Count</Label>
                                <PropertyName>EnforcementCount</PropertyName>
                            </ListItem>
                            <ListItem>
                                <Label>Snapshot Action</Label>
                                <PropertyName>SnapshotAction</PropertyName>
                            </ListItem>
                            <ListItem>
                                <Label>Requires Snapshot</Label>
                                <PropertyName>RequiresSnapshot</PropertyName>
                            </ListItem>
                            <ListItem>
                                <Label>Validation Status</Label>
                                <PropertyName>ValidationStatus</PropertyName>
                            </ListItem>
                            <ListItem>
                                <Label>Enforcements</Label>
                                <PropertyName>Enforcements</PropertyName>
                            </ListItem>
                            <ListItem>
                                <Label>OS Name</Label>
                                <PropertyName>OsName</PropertyName>
                            </ListItem>
                            <ListItem>
                                <Label>OS Build</Label>
                                <PropertyName>OsBuild</PropertyName>
                            </ListItem>
                            <ListItem>
                                <Label>OS Revision</Label>
                                <PropertyName>OsUBR</PropertyName>
                            </ListItem>
                        </ListItems>
                    </ListEntry>
                </ListEntries>
            </ListControl>
        </View>
        <!-- ============================================================ -->
        <!-- RDPControl.EnforcementResult                                 -->
        <!-- ============================================================ -->
        <View>
            <Name>RDPControl.EnforcementResult</Name>
            <ViewSelectedBy>
                <TypeName>RDPControl.EnforcementResult</TypeName>
            </ViewSelectedBy>
            <ListControl>
                <ListEntries>
                    <ListEntry>
                        <ListItems>
                            <ListItem>
                                <Label>State</Label>
                                <PropertyName>State</PropertyName>
                            </ListItem>
                            <ListItem>
                                <Label>Restore Snapshot ID</Label>
                                <PropertyName>SnapshotId</PropertyName>
                            </ListItem>
                            <ListItem>
                                <Label>Write Offset</Label>
                                <PropertyName>WriteOffset</PropertyName>
                            </ListItem>
                            <ListItem>
                                <Label>Hash</Label>
                                <PropertyName>Hash</PropertyName>
                            </ListItem>
                            <ListItem>
                                <Label>Enforced At</Label>
                                <ScriptBlock>
                                    if ($_.EnforcedAt) {
                                        [datetime]::Parse($_.EnforcedAt).ToUniversalTime().ToString('yyyy-MM-dd HH:mm:ss') + ' UTC'
                                    }
                                </ScriptBlock>
                            </ListItem>
                        </ListItems>
                    </ListEntry>
                </ListEntries>
            </ListControl>
        </View>
        <!-- ============================================================ -->
        <!-- RDPControl.RestoreResult                                     -->
        <!-- ============================================================ -->
        <View>
            <Name>RDPControl.RestoreResult</Name>
            <ViewSelectedBy>
                <TypeName>RDPControl.RestoreResult</TypeName>
            </ViewSelectedBy>
            <ListControl>
                <ListEntries>
                    <ListEntry>
                        <ListItems>
                            <ListItem>
                                <Label>Snapshot ID</Label>
                                <PropertyName>SnapshotId</PropertyName>
                            </ListItem>
                            <ListItem>
                                <Label>Hash</Label>
                                <PropertyName>Hash</PropertyName>
                            </ListItem>
                            <ListItem>
                                <Label>Restored At</Label>
                                <ScriptBlock>
                                    if ($_.RestoredAt) {
                                        [datetime]::Parse($_.RestoredAt).ToUniversalTime().ToString('yyyy-MM-dd HH:mm:ss') + ' UTC'
                                    }
                                </ScriptBlock>
                            </ListItem>
                        </ListItems>
                    </ListEntry>
                </ListEntries>
            </ListControl>
        </View>
        <!-- ============================================================ -->
        <!-- RDPControl.SessionModeInfo                                   -->
        <!-- ============================================================ -->
        <View>
            <Name>RDPControl.SessionModeInfo</Name>
            <ViewSelectedBy>
                <TypeName>RDPControl.SessionModeInfo</TypeName>
            </ViewSelectedBy>
            <ListControl>
                <ListEntries>
                    <ListEntry>
                        <ListItems>
                            <ListItem>
                                <Label>Mode</Label>
                                <PropertyName>Mode</PropertyName>
                            </ListItem>
                            <ListItem>
                                <Label>Enforced</Label>
                                <PropertyName>Enforced</PropertyName>
                            </ListItem>
                            <ListItem>
                                <Label>Hash</Label>
                                <PropertyName>Hash</PropertyName>
                            </ListItem>
                            <ListItem>
                                <Label>Checked At</Label>
                                <ScriptBlock>
                                    if ($_.CheckedAt) {
                                        [datetime]::Parse($_.CheckedAt).ToUniversalTime().ToString('yyyy-MM-dd HH:mm:ss') + ' UTC'
                                    }
                                </ScriptBlock>
                            </ListItem>
                        </ListItems>
                    </ListEntry>
                </ListEntries>
            </ListControl>
        </View>
        <!-- ============================================================ -->
        <!-- RDPControl.SnapshotInfo                                      -->
        <!-- ============================================================ -->
        <View>
            <Name>RDPControl.SnapshotInfo</Name>
            <ViewSelectedBy>
                <TypeName>RDPControl.SnapshotInfo</TypeName>
            </ViewSelectedBy>
            <ListControl>
                <ListEntries>
                    <ListEntry>
                        <ListItems>
                            <ListItem>
                                <Label>ID</Label>
                                <PropertyName>id</PropertyName>
                            </ListItem>
                            <ListItem>
                                <Label>Status</Label>
                                <ScriptBlock>
                                    if ($_.enforced) { 'Enforced' } else { 'Restore Point' }
                                </ScriptBlock>
                            </ListItem>
                            <ListItem>
                                <Label>Created At</Label>
                                <ScriptBlock>
                                    if ($_.created_at) {
                                        [datetime]::Parse($_.created_at).ToUniversalTime().ToString('yyyy-MM-dd HH:mm:ss') + ' UTC'
                                    }
                                </ScriptBlock>
                            </ListItem>
                            <ListItem>
                                <Label>Binary Version</Label>
                                <PropertyName>binary_version</PropertyName>
                            </ListItem>
                            <ListItem>
                                <Label>OS Build</Label>
                                <PropertyName>os_build</PropertyName>
                            </ListItem>
                            <ListItem>
                                <Label>Hash</Label>
                                <PropertyName>sha256</PropertyName>
                            </ListItem>
                        </ListItems>
                    </ListEntry>
                </ListEntries>
            </ListControl>
        </View>
    </ViewDefinitions>
</Configuration>
